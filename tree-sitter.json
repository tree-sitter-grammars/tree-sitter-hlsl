{
  "grammars": [
    {
      "name": "hlsl",
      "camelcase": "HLSL",
      "title": "HLSL",
      "scope": "source.hlsl",
      "file-types": [
        "hlsl"
      ],
      "injection-regex": "^hlsl$",
      "class-name": "TreeSitterHLSL",
      "highlights": [
        "node_modules/tree-sitter-cpp/queries/highlights.scm"
      ],
      "injections": [
        "node_modules/tree-sitter-cpp/queries/injections.scm"
      ],
      "tags": [
        "node_modules/tree-sitter-cpp/queries/tags.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "HLSL grammar for tree-sitter",
    "authors": [
      {
        "name": "Stephan Seitz"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-hlsl"
    }
  }
}
